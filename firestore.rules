rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Config reference collections: Read-only for authenticated citizens, write only by Admin SDK
    match /config/{configDoc} {
      allow read: if true;
      allow write: if false;
    }

    // Reference task and badge catalogs
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /districts/{districtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profile: Can update own name, phone, district; cannot self-grant points, badges or admin role
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.role == 'citizen';
      allow update: if isOwner(userId) 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'points', 'streak', 'badges']);
      allow delete: if isAdmin();

      // User Telemetry Subcollection
      match /telemetry/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User Appliances Subcollection
      match /appliances/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Household Profiles
    match /households/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Baselines & Time-series Footprint Entries
    match /footprintBaselines/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /footprintEntries/{entryId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Task completions: Can only be created by user with pending verification; points awarded ONLY by Cloud Function
    match /taskCompletions/{completionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Must be handled authoritatively via Cloud Function `awardPoints`
    }

    // Nudges
    match /userNudges/{nudgeId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);
      allow write: if isAdmin();
    }

    // Leaderboards: Denormalized reads allowed, writes blocked from client
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // Sharded aggregate counters
    match /aggregates/{metric}/shards/{shardId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // Verified Mission Actions Log
    match /verifiedActions/{actionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Student ID Verifications & Campus Contribution
    match /studentVerifications/{verificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Solar Leads & Lifecycle Tracking
    match /solarLeads/{leadId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        request.auth.token.role == 'solar_vendor' || 
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        request.auth.token.role == 'solar_vendor' || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Centrally Stored Multi-Tier Analytics Aggregates
    match /analyticsAggregates/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Government Scheme Planning & Campaign Exposure Events
    match /schemeEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Redemptions
    match /redemptions/{redemptionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Cloud Functions only
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only
    }

    // Cache
    match /apiCache/{cacheId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
