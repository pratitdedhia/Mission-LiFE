# =============================================================================
# Mission LiFE - Environment Variables Template
# Copy this file to `.env` and fill in your authorized values.
# =============================================================================

# Firebase Web App Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Evaluation Demo Mode & Presets (Set to 'false' in hardened production deployments)
VITE_ENABLE_DEMO_LOGIN=true
VITE_DEMO_PASSWORD=your_demo_password_here

# Hardware Telemetry Authentication (ESP32 IoT Bridge)
DEVICE_API_KEY=geda_esp32_secret_key_2026

# Microservice & Hardware Telemetry Endpoint
VITE_MICROSERVICE_URL=http://localhost:8000

# Firebase Emulator Suite (Set to 'true' for local offline testing)
VITE_USE_FIREBASE_EMULATORS=false
VITE_EMULATOR_AUTH_URL=http://localhost:9099
VITE_EMULATOR_FIRESTORE_HOST=localhost
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_STORAGE_PORT=9199
VITE_EMULATOR_FUNCTIONS_PORT=5001
